{
  "rules": {
    "announcements": {
      ".read": true,
      ".write": "auth != null",
      ".indexOn": ["created_at", "is_published"]
    },
    "recommended_videos": {
      ".read": true,
      ".write": "auth != null",
      ".indexOn": ["sort_order", "is_published"]
    },
    "comments": {
      ".read": true,
      ".write": true,
      ".indexOn": ["created_at", "is_hidden"],
      "$commentId": {
        ".validate": "newData.hasChildren(['id', 'name', 'message'])"
      }
    },
    "site_visits": {
      ".read": true,
      ".write": true
    },
    "push_tokens": {
      ".read": true,
      ".write": true,
      ".indexOn": ["is_active"]
    },
    "push_state": {
      ".read": true,
      ".write": true
    },
    "push_broadcasts": {
      ".read": true,
      ".write": "auth != null",
      ".indexOn": ["created_at"]
    },
    "push_log": {
      ".read": true,
      ".write": "auth != null",
      ".indexOn": ["at"]
    },
    "profiles": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "user_roles": {
      ".read": true,
      ".write": "auth != null"
    }
  }
}
