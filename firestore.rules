rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Lectura pública de anuncios y videos recomendados
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if request.auth != null; // ajustar según roles de admin
    }

    match /recommended_videos/{videoId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Comentarios
    match /comments/{commentId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if request.auth != null;
    }

    // Visitas
    match /site_visits/{visitId} {
      allow read, write: if true;
    }

    // Tokens de push
    match /push_tokens/{tokenId} {
      allow read, write: if true;
    }

    // Regla general de seguridad por defecto
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
